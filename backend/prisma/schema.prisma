// ==============================================================
// Prisma Schema - DiagramaServers
// Mapeo fiel de las tablas existentes en PostgreSQL
// Schemas: inventory, users, monitoring
// ==============================================================

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["inventory", "users", "monitoring", "public"]
}

// ─────────────────────────────────────────────
//  INVENTORY SCHEMA
// ─────────────────────────────────────────────

enum ServerTypeEnum {
  fisicos
  virtuales

  @@map("server_type_enum")
  @@schema("inventory")
}

model Rack {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  rawName   String?  @map("raw_name")
  type      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  servers      Server[]
  clusterHosts ClusterHost[]

  @@map("racks")
  @@schema("inventory")
}

model Server {
  id                  BigInt         @id @default(autoincrement())
  type                ServerTypeEnum
  identityKey         String         @map("identity_key")
  rackId              BigInt?        @map("rack_id")
  rackNorm            String?        @map("rack_norm")
  rackRaw             String?        @map("rack_raw")
  serverLabel         String?        @map("server_label")
  nombre              String?
  ip                  String?
  hostname            String?
  usuario             String?
  marca               String?
  modelo              String?
  tipo                String?
  hardware            String?
  serie               String?
  socket              String?
  noPorSocket         String?        @map("no_por_socket")
  procesadoresLogicos String?        @map("procesadores_logicos")
  ramGb               String?        @map("ram_gb")
  discos              String?
  datastore           String?
  conexion            String?
  software            String?
  so                  String?
  fechaInstalacion    String?        @map("fecha_instalacion")
  fechaMantenimiento  String?        @map("fecha_mantenimiento")
  estado              String?
  backup              String?
  fechaBackup         String?        @map("fecha_backup")
  activo              String?
  // Campos físicos
  storage             String?
  ocsInventario       String?        @map("ocs_inventario")
  datastoreVirtuales  String?        @map("datastore_virtuales")
  conexionStorage     String?        @map("conexion_storage")
  // Campos virtuales (seguridad)
  mtm                 String?
  configBackup        String?        @map("config_backup")
  sophosEp            String?        @map("sophos_ep")
  vicarius            String?
  acronis             String?
  veeam               String?
  manual              String?
  zabbix              String?
  wazuh               String?
  bluelevel           String?
  pam                 String?
  usuarioPam          String?        @map("usuario_pam")
  // Posición en rack
  rackPosition        Int?           @map("rack_position")
  rackUnits           Int?           @default(2) @map("rack_units")
  // Timestamps
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  rack Rack? @relation(fields: [rackId], references: [id], onDelete: SetNull)

  @@unique([type, identityKey])
  @@index([rackId], map: "servers_rack_idx")
  @@index([type], map: "servers_type_idx")
  @@index([ip], map: "servers_ip_idx")
  @@index([hostname], map: "servers_hostname_idx")
  @@map("servers")
  @@schema("inventory")
}

model VirtualCluster {
  id           BigInt   @id @default(autoincrement())
  name         String   @unique
  key          String   @unique
  description  String?
  type         String   @default("cluster")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  hosts ClusterHost[]

  @@map("virtual_clusters")
  @@schema("inventory")
}

model ClusterHost {
  id        BigInt   @id @default(autoincrement())
  clusterId BigInt   @map("cluster_id")
  rackId    BigInt   @map("rack_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  cluster VirtualCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  rack    Rack           @relation(fields: [rackId], references: [id], onDelete: Cascade)

  @@unique([clusterId, rackId])
  @@map("cluster_hosts")
  @@schema("inventory")
}

// ─────────────────────────────────────────────
//  USERS SCHEMA
// ─────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @db.VarChar(20)
  name         String    @db.VarChar(100)
  email        String?   @db.VarChar(100)
  active       Boolean?  @default(true)
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime? @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @map("updated_at")

  passwordResetTokens PasswordResetToken[]

  @@index([username], map: "idx_users_username")
  @@index([role], map: "idx_users_role")
  @@index([active], map: "idx_users_active")
  @@map("users")
  @@schema("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_password_reset_token_hash")
  @@index([userId], map: "idx_password_reset_user_id")
  @@map("password_reset_tokens")
  @@schema("users")
}

// ─────────────────────────────────────────────
//  MONITORING SCHEMA
// ─────────────────────────────────────────────

enum HostTypeEnum {
  fisico
  virtual

  @@map("host_type_enum")
  @@schema("monitoring")
}

enum CheckKindEnum {
  icmp
  tcp
  http

  @@map("check_kind_enum")
  @@schema("monitoring")
}

enum RunStatusEnum {
  ok
  fail
  timeout
  degraded

  @@map("run_status_enum")
  @@schema("monitoring")
}

enum IncidentStateEnum {
  open
  ack
  resolved
  closed

  @@map("incident_state_enum")
  @@schema("monitoring")
}

enum IncidentSeverityEnum {
  critical
  warning
  info

  @@map("incident_severity_enum")
  @@schema("monitoring")
}

model MonitoringHost {
  id              BigInt       @id @default(autoincrement())
  name            String
  ip              String?      @db.Inet
  type            HostTypeEnum
  rack            String?
  critical        Boolean      @default(false)
  groupTags       String[]     @default([]) @map("group_tags")
  enabled         Boolean      @default(true)
  estadoActual    String       @default("UNKNOWN") @map("estado_actual")
  estadoChangedAt DateTime?    @map("estado_changed_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  checks    MonitoringCheck[]
  checkRuns CheckRun[]
  incidents Incident[]

  @@index([ip], map: "hosts_ip_idx")
  @@index([estadoActual], map: "hosts_estado_idx")
  @@map("hosts")
  @@schema("monitoring")
}

model MonitoringCheck {
  id           BigInt    @id @default(autoincrement())
  hostId       BigInt    @map("host_id")
  kind         CheckKindEnum
  config       Json      @default("{}")
  frequencySec Int       @default(60) @map("frequency_sec")
  timeoutMs    Int       @default(2000) @map("timeout_ms")
  retries      Int       @default(0)
  enabled      Boolean   @default(true)
  nextRunAt    DateTime? @map("next_run_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  host      MonitoringHost @relation(fields: [hostId], references: [id], onDelete: Cascade)
  checkRuns CheckRun[]

  @@index([hostId], map: "checks_host_idx")
  @@index([enabled], map: "checks_enabled_idx")
  @@index([nextRunAt], map: "checks_next_run_idx")
  @@map("checks")
  @@schema("monitoring")
}

model CheckRun {
  time      DateTime      @db.Timestamptz
  checkId   BigInt        @map("check_id")
  hostId    BigInt        @map("host_id")
  status    RunStatusEnum
  latencyMs Int?          @map("latency_ms")
  code      Int?
  error     String?
  sample    Json?

  check MonitoringCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  host  MonitoringHost  @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@id([time, checkId])
  @@index([hostId, time(sort: Desc)], map: "check_runs_host_time_idx")
  @@index([checkId, time(sort: Desc)], map: "check_runs_check_time_idx")
  @@index([status], map: "check_runs_status_idx")
  @@map("check_runs")
  @@schema("monitoring")
}

model Incident {
  id          BigInt               @id @default(autoincrement())
  hostId      BigInt               @map("host_id")
  severity    IncidentSeverityEnum @default(critical)
  state       IncidentStateEnum    @default(open)
  openedAt    DateTime             @default(now()) @map("opened_at") @db.Timestamptz
  lastEventAt DateTime             @default(now()) @map("last_event_at") @db.Timestamptz
  closedAt    DateTime?            @map("closed_at") @db.Timestamptz
  summary     String?

  host   MonitoringHost  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  events IncidentEvent[]

  @@index([hostId], map: "incidents_host_idx")
  @@index([state], map: "incidents_state_idx")
  @@map("incidents")
  @@schema("monitoring")
}

model IncidentEvent {
  id         BigInt   @id @default(autoincrement())
  incidentId BigInt   @map("incident_id")
  type       String
  payload    Json     @default("{}")
  at         DateTime @default(now()) @db.Timestamptz

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at(sort: Desc)], map: "incident_events_incident_idx")
  @@map("incident_events")
  @@schema("monitoring")
}

model AlertRecipient {
  id              BigInt   @id @default(autoincrement())
  email           String   @unique
  name            String?
  enabled         Boolean  @default(true)
  notifyDown      Boolean  @default(true) @map("notify_down")
  notifyDegraded  Boolean  @default(true) @map("notify_degraded")
  notifyRecovery  Boolean  @default(true) @map("notify_recovery")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([enabled], map: "alert_recipients_enabled_idx")
  @@map("alert_recipients")
  @@schema("monitoring")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  actor    String
  action   String
  entity   String
  entityId String   @map("entity_id")
  diff     Json?
  at       DateTime @default(now()) @db.Timestamptz

  @@map("audit_log")
  @@schema("monitoring")
}
