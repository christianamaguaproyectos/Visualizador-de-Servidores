# ===========================================
# Variables de entorno para Docker
# Copia este archivo a .env y modifica los valores
# ===========================================

# === Base de Datos PostgreSQL ===
POSTGRES_USER=diagrama
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA
POSTGRES_DB=diagrama_servers
POSTGRES_PORT=5432

# === Aplicación ===
APP_PORT=3000
# Debe tener al menos 32 caracteres aleatorios (nunca reutilizar el de otro ambiente)
SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS

# URL pública con la que los usuarios abren la app (se usa en los enlaces de los correos)
APP_URL=http://localhost:3000

# === Seguridad HTTP ===
# Orígenes externos autorizados para CORS, separados por coma (vacío = solo el mismo sitio)
CORS_ORIGINS=
# Detrás de un reverse proxy (nginx/traefik): número de proxies o "true". Vacío/false si no hay proxy
TRUST_PROXY=false

# === Monitoreo ===
MONITORING_ENABLED=1
# Subredes que los checks pueden alcanzar aunque estén en rangos bloqueados
# (loopback, link-local...). Ejemplo: 127.0.0.1/32. Vacío = ninguna excepción
MONITORING_ALLOWED_CIDRS=

# === Notificaciones por Email (Opcional) ===
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=usuario@empresa.com
# SMTP_PASS=contraseña
# ALERT_EMAIL_TO=admin@empresa.com,soporte@empresa.com

# === Microsoft Teams (Opcional) ===
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx

# === Timeouts de Checks (ms) ===
DEFAULT_PING_TIMEOUT_MS=2000
DEFAULT_TCP_TIMEOUT_MS=2000
DEFAULT_HTTP_TIMEOUT_MS=3000
