{
  "name": "diagrama-servers",
  "version": "0.3.0",
  "private": true,
  "description": "Visualizador interactivo de racks y servidores enlazado a Excel",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=backend/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-session": "^1.18.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "10.2.1",
    "pg": "^8.11.3",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "7.10.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
