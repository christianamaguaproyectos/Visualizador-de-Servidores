# Patrones a ignorar en builds de Docker
node_modules
npm-debug.log*
.git
.gitignore

# Archivos de configuración local
.env
.env.local
.env.*.local
config.json

# Logs y datos temporales
logs/
*.log

# Archivos de IDE
.vscode/
.idea/
*.swp
*.swo

# Archivos de sistema
.DS_Store
Thumbs.db

# Documentación no necesaria en producción
*.md
!README.md

# Tests (si los hubiera)
__tests__/
*.test.js
*.spec.js
coverage/

# Archivos de desarrollo
nodemon.json
ecosystem.config.cjs
*.bat
*.ps1

# Package lock alternativo
yarn.lock
pnpm-lock.yaml

# ===== Secretos y datos sensibles (Fase 0.2 del plan de seguridad) =====
# Archivos de entorno con contraseñas (solo se permite la plantilla de ejemplo)
.env.*
!.env.docker.example

# Usuarios con contraseñas
backend/config/users.json

# Archivos subidos por usuarios y datos locales
backend/uploads/*
backend/data/*

# Volcados de base de datos (solo se permiten los scripts de esquema)
**/*.sql
!scripts/sql/*.sql
**/*.dump

# Hojas de calculo y exportaciones con datos reales
**/*.csv
**/*.xlsx
**/*.xls

# Archivos comprimidos pesados
**/*.tar
